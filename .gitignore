# Gradle / Kotlin build output
build/
.gradle/
.kotlin/
local.properties

# `kotlin-js-store/yarn.lock` is deliberately NOT ignored: the lockfile pins the
# npm dependency tree (including the Firebase SDK) so CI builds what was tested.

# IDE
.idea/
*.iml

# macOS
.DS_Store

# Claude Code local session state, kept out of the repo like the rest of the
# local-only tooling config.
.claude/

# Generated from whichever JDK happened to build locally; it pins the daemon
# toolchain and would override the Java version the CI workflow sets up.
gradle/gradle-daemon-jvm.properties

# Firebase emulator run artifacts. The emulators themselves are configured by
# `firebase.json`, which IS committed; these are logs and local state.
*-debug.log
.firebase/
firebase-export-*/
